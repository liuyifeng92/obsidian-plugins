{
	"name": "table-column-width",
	"version": "1.0.4",
	"description": "Obsidian plugin that renders markdown tables with fixed layout and per-column draggable widths, persisted inside the note file.",
	"main": "main.js",
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs production",
		"test": "vitest run"
	},
